# PUBLISH-side registry mapping. The @charlesgreen scope resolves to GitHub
# Packages; everything else stays on the public npm registry. Paired with the
# `publishConfig` block in package.json so a stray `pnpm publish` cannot reach
# public npm. (DESIGN.md §4.1)
#
# NODE_AUTH_TOKEN is supplied by the publish workflow (GITHUB_TOKEN, with
# `permissions: packages: write`). It is deliberately absent from the repo — no
# credential material is ever committed here.
@charlesgreen:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}

auto-install-peers=true
strict-peer-dependencies=false
